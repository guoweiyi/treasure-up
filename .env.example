# Generate unique values with: python deploy/bootstrap.py
# Never copy this example unchanged into a live environment.
POSTGRES_PASSWORD=
TREASURE_ADMIN_USERNAME=admin
TREASURE_ADMIN_PASSWORD=
TREASURE_SECRET_KEY=
TREASURE_BACKUP_KEY=
# false only for the default localhost HTTP preview; public HTTPS must use true.
TREASURE_COOKIE_SECURE=false
TREASURE_ALLOWED_HOSTS=localhost,127.0.0.1
TREASURE_PASSKEY_ORIGIN=http://localhost:8788
TREASURE_PASSKEY_RP_ID=localhost
TREASURE_PASSKEYS_ENABLED=true
# Existing deployments: python deploy/bootstrap.py --origin https://video.example.com
# Then recreate API with the same Compose files used to start this deployment.
# HTTP tunnels require explicit --allow-http and disable passkeys.
TREASURE_PORT=8788
