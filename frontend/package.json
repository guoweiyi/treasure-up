{
  "name": "treasure-up-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test src/player/*.test.mjs src/utils/*.test.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src public/userscripts package.json tsconfig.json vite.config.ts index.html .prettierrc.json README.md",
    "format:check": "prettier --check src public/userscripts package.json tsconfig.json vite.config.ts index.html .prettierrc.json README.md"
  },
  "dependencies": {
    "artplayer": "5.4.0",
    "artplayer-plugin-danmuku": "5.3.0",
    "element-plus": "^2.10.0",
    "hls.js": "1.7.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.0"
  }
}
