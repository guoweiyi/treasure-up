<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23501" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23501"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-root">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="brand-surface">
                                <rect key="frame" x="112.5" y="342" width="168" height="168"/>
                                <subviews>
                                    <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="BrandMark" translatesAutoresizingMaskIntoConstraints="NO" id="brand-image">
                                        <rect key="frame" x="12" y="12" width="144" height="144"/>
                                    </imageView>
                                </subviews>
                                <color key="backgroundColor" name="BrandSurface"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="168" id="brand-width"/>
                                    <constraint firstAttribute="height" constant="168" id="brand-height"/>
                                    <constraint firstItem="brand-image" firstAttribute="top" secondItem="brand-surface" secondAttribute="top" constant="12" id="image-top"/>
                                    <constraint firstAttribute="bottom" secondItem="brand-image" secondAttribute="bottom" constant="12" id="image-bottom"/>
                                    <constraint firstItem="brand-image" firstAttribute="leading" secondItem="brand-surface" secondAttribute="leading" constant="12" id="image-leading"/>
                                    <constraint firstAttribute="trailing" secondItem="brand-image" secondAttribute="trailing" constant="12" id="image-trailing"/>
                                </constraints>
                            </view>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe-area"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
