{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treasure Up",
  "version": "0.3.0",
  "identifier": "app.treasureup.viewer",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["launcher"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; frame-src 'none'; object-src 'none'; form-action 'none'",
      "assetProtocol": { "enable": false, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "iOS": { "minimumSystemVersion": "15.0" },
    "android": { "minSdkVersion": 26 }
  }
}
