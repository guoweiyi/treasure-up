FROM docker:28.5.2-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d AS docker-cli
FROM python:3.12-slim-trixie@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016
ARG DOCKERHUB_NAMESPACE=yunyunjuan
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TREASURE_INSTALL_NAMESPACE=${DOCKERHUB_NAMESPACE}
WORKDIR /app
RUN pip install --no-compile --no-cache-dir PyYAML==6.0.3 python-dotenv==1.2.4
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY deploy/launch.py deploy/install.py deploy/setup.py /app/
COPY compose.yaml compose.light.yaml release.json /app/install/
USER 0
ENTRYPOINT ["python", "/app/launch.py"]
